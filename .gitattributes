# export-ignore keeps these out of GitHub's "Download ZIP" button and the
# zip GitHub auto-attaches to every Release — both are generated the same
# way `git archive` is, so this is honored without removing anything from
# the actual repository or affecting normal clones/checkouts. Anyone
# downloading a release should get exactly what they need to run the app
# (see README.md), not the project's own dev/build/test tooling.
.claude/ export-ignore
scripts/ export-ignore
tests/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
