# Built binaries — regenerable via scripts/build-exe.js, large, don't belong in history.
dist/

# Legacy in-project data folder (pre-1.1.0 storage location) — this is real,
# personal library data (backups, downloaded covers, cache), never source.
# Current installs store data in the OS app-data folder instead; see datadir.js.
data/

node_modules/

# Playwright run output (traces, screenshots on failure, last-run marker) —
# regenerated every run, not source.
test-results/
playwright-report/

# Local Claude Code permission/settings overrides — machine-specific, never
# shared project config (.claude/launch.json above stays tracked).
.claude/settings.local.json

# OS/editor junk
.DS_Store
Thumbs.db

# Logs and temp output: never source (v3.0.0 release hygiene).
*.log
logs/
tmp/
temp/
*.tmp
.cache/

# Library data and backups that may be someone's real data: a backup or
# export is never committed (test fixtures live in tests/fixtures/).
backups/
*-backup*.json
anime-tracker-backup*.json
library-*.json
events-*.json
snapshot-*.json
poster-cache/
covers/
!tests/fixtures/**

# Secrets and local config
.env
.env.*
*.pem
*.key
cookies*.txt

# Claude Code worktrees and per-machine state
.claude/worktrees/

# Verify-script output that may show a real library (use demo data for docs)
verify-out/
