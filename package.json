{
  "name": "anime-tracker",
  "version": "3.0.0",
  "private": true,
  "description": "Local-only anime tracker. No runtime dependencies, no build step. devDependencies are for tests and tooling only: Playwright (end-to-end tests), esbuild, postject and rcedit (the Windows exe), fontkit (the font manifest generator).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/check-css-tokens.js && node --test \"tests/unit/**/*.test.{js,mjs}\"",
    "check:css": "node scripts/check-css-tokens.js",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.js",
    "eval:discover": "node scripts/eval-discover.js",
    "check:copy": "node scripts/check-copy-registry.js",
    "generate:font-manifest": "node scripts/generate-font-manifest.js",
    "test:unit": "node --test \"tests/unit/**/*.test.{js,mjs}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "0.28.2",
    "fontkit": "^2.0.4",
    "postject": "1.0.0-alpha.6",
    "rcedit": "5.0.2"
  }
}
